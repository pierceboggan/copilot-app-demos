{
  "uid": "copilot-agent-overview",
  "title": "GitHub Copilot — agent overview",
  "description": "Model cost, latency, and tool behaviour for Copilot agents, built from the OTel GenAI semantic conventions the Copilot runtime emits. Metric and label names were taken from a live capture, not from the docs.",
  "tags": ["copilot", "opentelemetry", "genai"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
        "query": "label_values(gen_ai_client_token_usage_sum, gen_ai_request_model)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "service_version",
        "label": "Client version",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
        "query": "label_values(gen_ai_client_token_usage_sum, service_version)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Consumption",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Input tokens",
      "description": "Sum of gen_ai.client.token.usage where gen_ai.token.type = input.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"input\", gen_ai_request_model=~\"$model\", service_version=~\"$service_version\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Output tokens",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gen_ai_client_token_usage_sum{gen_ai_token_type=\"output\", gen_ai_request_model=~\"$model\", service_version=~\"$service_version\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Model calls",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(gen_ai_client_operation_duration_seconds_count{gen_ai_operation_name=\"chat\", gen_ai_request_model=~\"$model\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tool calls",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(github_copilot_tool_call_count_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Tool failure rate",
      "description": "Share of github.copilot.tool.call.count with success = false.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(github_copilot_tool_call_count_total{success=\"false\"}[$__range])) / clamp_min(sum(increase(github_copilot_tool_call_count_total[$__range])), 1)",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Net lines changed",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(github_copilot_code_lines_added_total[$__range])) - sum(increase(github_copilot_code_lines_removed_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token throughput by model",
      "description": "Where the spend goes. Split by gen_ai.token.type so cache-heavy models are visible.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 12, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{gen_ai_request_model}} · {{gen_ai_token_type}}",
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum{gen_ai_request_model=~\"$model\", service_version=~\"$service_version\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model call latency",
      "description": "p50 / p95 / p99 of gen_ai.client.operation.duration for chat operations.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{gen_ai_operation_name=\"chat\", gen_ai_request_model=~\"$model\"}[$__rate_interval])))"
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{gen_ai_operation_name=\"chat\", gen_ai_request_model=~\"$model\"}[$__rate_interval])))"
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_seconds_bucket{gen_ai_operation_name=\"chat\", gen_ai_request_model=~\"$model\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Responsiveness",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "Time to first chunk (p95) by model",
      "description": "The number users actually feel. Streaming only.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{gen_ai_request_model}}",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_time_to_first_chunk_seconds_bucket{gen_ai_request_model=~\"$model\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Agent invocation duration (p95) by agent",
      "description": "gen_ai.invoke_agent.duration covers a whole user turn, including subagents.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{gen_ai_agent_name}}",
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_agent_name) (rate(gen_ai_invoke_agent_duration_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Tools and MCP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "barchart",
      "title": "Busiest tools",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 25 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 80 } },
        "overrides": []
      },
      "options": { "orientation": "horizontal", "legend": { "showLegend": false } },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "legendFormat": "{{gen_ai_tool_name}}",
          "expr": "topk(12, sum by (gen_ai_tool_name) (increase(github_copilot_tool_call_count_total[$__range])))"
        }
      ]
    },
    {
      "type": "table",
      "title": "Tool latency and failures",
      "description": "p95 duration per tool alongside its failure count. A slow tool and a failing tool need different fixes.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 9, "w": 10, "x": 8, "y": 25 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 2 }]
          }
        ]
      },
      "options": { "showHeader": true },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_tool_name) (rate(github_copilot_tool_call_duration_seconds_bucket[$__rate_interval])))"
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (gen_ai_tool_name) (increase(github_copilot_tool_call_count_total{success=\"false\"}[$__range]))"
        }
      ],
      "transformations": [
        { "id": "joinByField", "options": { "byField": "gen_ai_tool_name", "mode": "outer" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time 1": true, "Time 2": true },
            "renameByName": {
              "gen_ai_tool_name": "Tool",
              "Value #A": "p95",
              "Value #B": "Failures"
            }
          }
        },
        { "id": "sortBy", "options": { "fields": {}, "sort": [{ "field": "p95", "desc": true }] } }
      ]
    },
    {
      "type": "timeseries",
      "title": "MCP server connection outcomes",
      "description": "A rising failure line usually means a managed allowlist or a credential problem, not a flaky server.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 25 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 1, "showPoints": "never", "stacking": { "mode": "normal" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failure" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{outcome}}",
          "expr": "sum by (outcome) (rate(github_copilot_mcp_server_connection_count_total[$__rate_interval]))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Code impact",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 }
    },
    {
      "type": "timeseries",
      "title": "Lines added and removed by model",
      "description": "Recorded in real time by the file-editing tools, so it reflects what the agent actually wrote rather than what was later committed.",
      "datasource": { "type": "prometheus", "uid": "copilot-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 35 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 15, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "added · {{gen_ai_request_model}}",
          "expr": "sum by (gen_ai_request_model) (rate(github_copilot_code_lines_added_total{gen_ai_request_model=~\"$model\"}[$__rate_interval]))"
        },
        {
          "refId": "B",
          "legendFormat": "removed · {{gen_ai_request_model}}",
          "expr": "-sum by (gen_ai_request_model) (rate(github_copilot_code_lines_removed_total{gen_ai_request_model=~\"$model\"}[$__rate_interval]))"
        }
      ]
    }
  ]
}
